<?xml version="1.0"?>
<robot name="MAMA_robot">
  
  <!-- Dummy link required for some Gazebo versions -->
  <link name="base_link">
    <visual>
      <geometry>
        <!-- Replace with your actual package name if different -->
        <mesh filename="package://MAMA_robot/meshes/model.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://MAMA_robot/meshes/model.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Gazebo specific plugin to ensure it renders -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
</robot>
